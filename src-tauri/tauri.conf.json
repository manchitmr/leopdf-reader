{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LeoPDF Reader",
  "version": "0.1.0",
  "identifier": "io.github.manchitmr.leopdf",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LeoPDF Reader",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF Document",
        "description": "PDF Document",
        "role": "Viewer",
        "mimeType": "application/pdf"
      }
    ],
    "category": "Productivity",
    "shortDescription": "PDF reader with first-class Sinhala and Tamil support",
    "copyright": "AGPL-3.0-or-later"
  }
}
